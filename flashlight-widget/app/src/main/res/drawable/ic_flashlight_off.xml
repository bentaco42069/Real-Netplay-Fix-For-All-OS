<!--
  Norse Age Mjölnir amulet (unlit / pewter).
  Based on the real Viking pendants: short stout body, a head that flares out
  at the lower corners, a suspension loop up top, and punched-dot ornament.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Suspension loop at the top (how it hangs on the necklace). -->
    <path
        android:strokeColor="#BFC9CE"
        android:strokeWidth="1.1"
        android:fillColor="#00000000"
        android:pathData="M12,2.9 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0" />

    <!-- Amulet body: narrow neck, broad head flaring at the lower corners. -->
    <path
        android:fillColor="#BFC9CE"
        android:pathData="M10.9,4.0 L10.9,7.6 L8.0,8.6 L8.0,12.6 L7.2,13.0 L8.6,14.8 L12,14.4 L15.4,14.8 L16.8,13.0 L16.0,12.6 L16.0,8.6 L13.1,7.6 L13.1,4.0 Z" />

    <!-- Neck groove. -->
    <path
        android:fillColor="#7C8B94"
        android:pathData="M11.7,4.6 L12.3,4.6 L12.3,7.4 L11.7,7.4 Z" />

    <!-- Central boss. -->
    <path
        android:fillColor="#7C8B94"
        android:pathData="M12,10.6 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0" />

    <!-- Punched dots either side. -->
    <path
        android:fillColor="#7C8B94"
        android:pathData="M9.6,11.4 m-0.5,0 a0.5,0.5 0 1,0 1,0 a0.5,0.5 0 1,0 -1,0" />
    <path
        android:fillColor="#7C8B94"
        android:pathData="M14.4,11.4 m-0.5,0 a0.5,0.5 0 1,0 1,0 a0.5,0.5 0 1,0 -1,0" />
</vector>
