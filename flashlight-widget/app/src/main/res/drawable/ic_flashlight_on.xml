<!--
  Mjölnir, charged (lit / gold) — broad hammer head UP top with a lightning
  bolt cracking out of the striking face, handle hanging down.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Lightning bolt bursting up out of the top of the hammer head. -->
    <path
        android:fillColor="#FFF176"
        android:pathData="M12.9,0.4 L10.3,4.0 L12.0,4.0 L11.1,5.8 L14.2,2.2 L12.4,2.2 Z" />

    <!-- Hammer body: broad head on top, handle down, flared pommel. -->
    <path
        android:fillColor="#FFCA28"
        android:pathData="M7.2,4.4 L16.8,4.4 L16.1,7.6 L13.1,8.5 L13.1,18.2 L14.1,18.2 L14.1,19.8 L9.9,19.8 L9.9,18.2 L10.9,18.2 L10.9,8.5 L7.9,7.6 Z" />

    <!-- Central boss on the head. -->
    <path
        android:fillColor="#FF8F00"
        android:pathData="M12,6 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0" />

    <!-- Punched dots either side of the boss. -->
    <path
        android:fillColor="#FF8F00"
        android:pathData="M9.5,6 m-0.45,0 a0.45,0.45 0 1,0 0.9,0 a0.45,0.45 0 1,0 -0.9,0" />
    <path
        android:fillColor="#FF8F00"
        android:pathData="M14.5,6 m-0.45,0 a0.45,0.45 0 1,0 0.9,0 a0.45,0.45 0 1,0 -0.9,0" />

    <!-- Grip wraps on the handle. -->
    <path android:fillColor="#FF8F00" android:pathData="M10.9,11 L13.1,11 L13.1,11.7 L10.9,11.7 Z" />
    <path android:fillColor="#FF8F00" android:pathData="M10.9,13 L13.1,13 L13.1,13.7 L10.9,13.7 Z" />
    <path android:fillColor="#FF8F00" android:pathData="M10.9,15 L13.1,15 L13.1,15.7 L10.9,15.7 Z" />
</vector>
